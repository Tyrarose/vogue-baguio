<%- include("header.ejs") %>
<main>
    <section class="titlebg text-center py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12">
                    <div class="logo">VOGUE BAGUIO</div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 cold_gray d-flex justify-content-center align-items-center">
        <div class="container">
            <div class="row g-4">
                
                <div class="col-lg-5 col-sm-12 d-flex justify-content-center">
                    <!-- Main Featured -->
                    <div class="card featured w-100 shadow-lg border-0">
                        <div class="imageholder">
                            <img class="card-img-top" src="<%= mainFeaturedArticle.img %>" alt="Card image cap">
                        </div>
                        <div class="card-body text-center">
                            <h5 class="card-title"><%= mainFeaturedArticle.title %></h5>
                            <p class="card-text">
                                <%= mainFeaturedArticle.content.length > 100 ? mainFeaturedArticle.content.slice(0, 250) + '...' : mainFeaturedArticle.content %>
                            </p>
                            <a href="/post/<%= mainFeaturedArticle.id %>" class="btn btn-dark">Read more</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-7 col-sm-12">
                    <div class="row g-4">
                        <% articles.forEach(article => { %>
                            <% if (parseInt(article.id) >= 2 && parseInt(article.id) <= 4) { %>
                                <!-- Sub Featured -->
                                <div class="col-12">
                                    <div class="card flex-md-row featured shadow-sm border-0 align-items-center p-3">
                                        <div class="col-lg-3 d-flex justify-content-center">
                                            <img class="card-img-right" src="<%= article.img %>" alt="" style="height: 150px; object-fit: cover; border-radius: 8px;">
                                        </div>
                                        <div class="card-body">
                                            <h5 class="card-title"><%= article.title %></h5>
                                            <p class="card-text">
                                                <%= article.content && article.content.length > 50 ? article.content.slice(0, 100) + '...' : article.body.slice(0, 100) + '...' %>
                                            </p>
                                            <a href="/post/<%= article.id %>" class="btn btn-dark btn-sm">Read more</a>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
<%- include("footer.ejs") %>