<%- include("header.ejs") %>
<section class="container mt-4">
	<div class="row">
		<div class="col-12 text-center">
			<img
				src="<%= article.img %>"
				alt="<%= article.title %>"
				class="img-fluid h-100"
				style="width: 500px"
			/>
		</div>
		<div class="col-12 mt-3">
			<h1><%= article.title %></h1>
			<p><%= article.content %></p>
		</div>
	</div>
</section>
<%- include("footer.ejs") %>
